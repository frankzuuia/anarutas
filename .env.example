# Runtime de CADA instalación. Ningún dato de Odoo ni cuenta viene en el código.
RUTAS_INSTANCE_ID=
RUTAS_APP_ORIGIN=
RUTAS_DATABASE_URL=
# Secreto de alta inicial; quitarlo de EasyPanel después de crear la primera cuenta.
RUTAS_BOOTSTRAP_TOKEN=
RUTAS_DISPLAY_NAME=Ana Rutas
RUTAS_TIMEZONE=
# Conexión Odoo de esta instalación. No se hereda de otros servicios.
ODOO_URL=
ODOO_DATABASE=
ODOO_EMAIL=
ODOO_API_KEY=
ODOO_COMPANY_ID=
# Alternativas admitidas: ODOO_USERNAME en vez de EMAIL, ODOO_PASSWORD en vez de API_KEY.
# Opcionales operativos, no datos de negocio:
RUTAS_SESSION_HOURS=12
RUTAS_IDLE_MINUTES=30
RUTAS_ODOO_TIMEOUT_MS=15000
# Opcionales: por defecto descubre el campo Studio por etiqueta exacta Nota para picker.
ODOO_SALE_ORDER_LINE_PICKER_NOTE_FIELD=
ODOO_PICKER_NOTE_FIELD_LABEL=
# Google Maps: clave de NAVEGADOR restringida al dominio y a Maps JavaScript/Geocoding.
# Se entrega solamente a usuarios autenticados, en runtime (no NEXT_PUBLIC).
# Nunca colocar aquí una clave de servidor ni una cuenta de servicio.
RUTAS_GOOGLE_MAPS_BROWSER_KEY=
RUTAS_GOOGLE_MAP_ID=
# Backend Google: proyecto y cuenta de servicio restringida a Route Optimization.
RUTAS_GOOGLE_CLOUD_PROJECT_ID=
RUTAS_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Sugerencia editable; las coordenadas sólo se guardan tras confirmar el punto.
RUTAS_DEPOT_ADDRESS=
# Reservada para refresco vial/Navigation SDK; nunca se expone al navegador.
RUTAS_GOOGLE_ROUTES_API_KEY=
# OpenAI planifica mediante herramientas; Google mide los recorridos candidatos.
# Configurar como secretos privados de EasyPanel, nunca como NEXT_PUBLIC.
RUTAS_OPENAI_API_KEY=
RUTAS_OPENAI_MODEL=
# Opcional. Recomendado high para ruteo complejo; debe ser compatible con el modelo.
RUTAS_OPENAI_REASONING_EFFORT=
# Opcionales cuando la clave pertenece a una organización/proyecto específicos.
RUTAS_OPENAI_ORGANIZATION_ID=
RUTAS_OPENAI_PROJECT_ID=
