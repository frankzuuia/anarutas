{
  "name": "ana-rutas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests docs *.ts *.mjs *.json README.md AGENTS.md",
    "bundle:migration": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=.local/migrate.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:vehicle-removal": "stryker run stryker.vehicle-removal.config.mjs",
    "test:mutation:order-removal": "stryker run stryker.order-removal.config.mjs",
    "test:mutation:plan-deletion": "stryker run stryker.plan-deletion.config.mjs",
    "test:mutation:plan-identity": "stryker run stryker.plan-identity.config.mjs",
    "test:mutation:customers": "stryker run stryker.customers.config.mjs",
    "test:mutation:routing": "stryker run stryker.routing.config.mjs",
    "test:mutation:route-observability": "stryker run stryker.route-observability.config.mjs",
    "test:mutation:route-logistics": "stryker run stryker.route-logistics.config.mjs",
    "test:mutation:fleet-routing-budget": "stryker run stryker.fleet-routing-budget.config.mjs",
    "test:mutation:direct-fleet": "stryker run stryker.direct-fleet.config.mjs",
    "test:mutation:route-incidents-query": "stryker run stryker.route-incidents-query.config.mjs",
    "test:mutation:routing-operations": "stryker run stryker.routing-operations.config.mjs",
    "test:mutation:google-consumption": "stryker run stryker.google-consumption.config.mjs",
    "test:mutation:order-candidates": "stryker run stryker.order-candidates.config.mjs",
    "test:mutation:driver-mobile": "stryker run stryker.driver-mobile.config.mjs",
    "test:mutation:route-start": "stryker run stryker.route-start.config.mjs",
    "test:mutation:route-publications": "stryker run stryker.route-publications.config.mjs",
    "test:mutation:route-cancellation": "stryker run stryker.route-cancellation.config.mjs",
    "test:mutation:route-publication-state": "stryker run stryker.route-publication-state.config.mjs",
    "test:mutation:route-map-markers": "stryker run stryker.route-map-markers.config.mjs",
    "test:mutation:unit-photos": "stryker run stryker.unit-photos.config.mjs",
    "test:mutation:unit-photo-deletion": "stryker run stryker.unit-photo-deletion.config.mjs",
    "test:mutation:driver-dashboard": "stryker run stryker.driver-dashboard.config.mjs",
    "test:mutation:route-push": "stryker run stryker.route-push.config.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "preview:local": "tsx scripts/local-preview.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "google-auth-library": "^10.5.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "^5.9",
    "vitest": "4.1.11"
  }
}
